if M.timer then M.timer.Enabled=false;M.timer.destroy() end
M.revision=5
local function api(name,...)
  local args={...}
  for i,v in ipairs(args) do args[i]={type=0,value=v} end
  return executeCodeLocalEx(getAddress(name,true),table.unpack(args))
end
local function must(v,name) assert(v and v~=0,name..' failed');return v end
local function bytes(hex)
  local out={};for v in hex:gmatch('%x%x') do out[#out+1]=tonumber(v,16) end;return out
end
local function equal(a,b)
