    if M.current(old) and old.enabled then error('This feature is already active in this CE session / 此功能已在当前 CE 中启用') end
    M.stop(old)
  end
  local s={key=key,record=record,script=script,meta=meta or {}}
  M.serial=M.serial+1;s.serial=M.serial;M.states[key]=s
  local ok,err=xpcall(function()
    s.pid=getOpenedProcessID();s.base=getAddressSafe('BH6.exe')
    assert(s.pid and s.pid&gt;0 and s.base,'Attach BH6.exe first / 请先连接 BH6.exe')
    s.handle=must(api('kernel32.OpenProcess',0x100c38,0,s.pid),'OpenProcess')
    s.buffer=createMemoryStream();s.buffer.Size=0x2000
    s.scratch=createMemoryStream();s.scratch.Size=0x1000
    local header=read(s,s.base,0x1000);local pe=u32(header,0x3c)
    assert(pe&gt;=64 and pe+0x54&lt;#header and u32(header,pe)==0x4550 and u32(header,pe+8)==0x51960399
      and u32(header,pe+0x50)==0x14a1000,'Unsupported BH6.exe build')
    local p=s.scratch.Memory
    must(api('kernel32.GetProcessTimes',s.handle,p,p+8,p+16,p+24),'GetProcessTimes')
    local lockKey=(key=='21915' or key=='21919') and 'game_over' or key
    for _,other in pairs(M.states) do
      assert(other==s or other.lockKey~=lockKey or not M.alive(other),
        'An overlapping option is already active / 修改同一地址的另一个选项已启用')
    end
    s.lockKey=lockKey
    local name=string.format('Local\\RE6_CT_%s_%d_%08X%08X',lockKey,s.pid,readIntegerLocal(p+4),readIntegerLocal(p))
    s.lock=must(executeCodeLocalEx(getAddress('kernel32.CreateMutexW',true),
      {type=0,value=0},{type=0,value=0},{type=4,value=name}),'CreateMutexW')
    local acquired=api('kernel32.WaitForSingleObject',s.lock,0)
    assert(acquired==0 or acquired==0x80,'Another CE owns this feature / 另一份 CE 正在控制此功能')
    s.ownsLock=true
    M.recover(s,s.meta.sites)
    -- Only this entry's old names can survive a CE process retarget.
    for _,name in ipairs(s.meta.symbols or {}) do unregisterSymbol(name) end
    for _,name in ipairs(s.meta.staleSymbols or {}) do unregisterSymbol(name) end
