  for i,v in ipairs(b) do if a[i]~=v then return false end end;return true
end
local function u32(t,i)
  i=(i or 0)+1;return t[i]|t[i+1]&lt;&lt;8|t[i+2]&lt;&lt;16|t[i+3]&lt;&lt;24
end
local function packed(v)
  return {v&amp;255,(v&gt;&gt;8)&amp;255,(v&gt;&gt;16)&amp;255,(v&gt;&gt;24)&amp;255}
end
local function join(...)
  local out={};for _,a in ipairs({...}) do for _,b in ipairs(a) do out[#out+1]=b end end;return out
end
function M.alive(s)
  if not s.handle then return false end
  local wait=api('kernel32.WaitForSingleObject',s.handle,0)
  assert(wait==0 or wait==258,'Cannot query the original game lifetime');return wait==258
end
function M.current(s)
  return M.alive(s) and s.pid==getOpenedProcessID() and getAddressSafe('BH6.exe')==s.base
end
local function read(s,address,n)
  must(api('kernel32.ReadProcessMemory',s.handle,address,s.buffer.Memory,n,s.scratch.Memory),'ReadProcessMemory')
  assert(readQwordLocal(s.scratch.Memory)==n,'Partial memory read')
  s.buffer.Position=0;return s.buffer.read(n)
end
local function write(s,address,data)
  s.buffer.Position=0;s.buffer.write(data)
  must(api('kernel32.WriteProcessMemory',s.handle,address,s.buffer.Memory,#data,s.scratch.Memory),'WriteProcessMemory')
  assert(readQwordLocal(s.scratch.Memory)==#data and equal(read(s,address,#data),data),'Patch readback mismatch')
  must(api('kernel32.FlushInstructionCache',s.handle,address,#data),'FlushInstructionCache')
end
local function protect(s,address,n,value)
  must(api('kernel32.VirtualProtectEx',s.handle,address,n,value,s.scratch.Memory),'VirtualProtectEx')
  return readIntegerLocal(s.scratch.Memory)
end
local function busy(s,changes)
  local snap=api('kernel32.CreateToolhelp32Snapshot',4,0)
  assert(snap and snap~=0 and snap~=-1,'Thread snapshot failed')
  local result=false
  local ok,err=pcall(function()
    local p=s.scratch.Memory+0x100;writeIntegerLocal(p,28)
    local more=must(api('kernel32.Thread32First',snap,p),'Thread32First')
    local count=0
    while more~=0 do
      if readIntegerLocal(p+12)==s.pid then
        local h=must(api('kernel32.OpenThread',0x48,0,readIntegerLocal(p+8)),'OpenThread')
        local ctx=s.scratch.Memory+0x200;writeIntegerLocal(ctx,0x10001)
        local got=api('kernel32.Wow64GetThreadContext',h,ctx)
        local ip=readIntegerLocal(ctx+184);api('kernel32.CloseHandle',h)
        must(got,'Wow64GetThreadContext');count=count+1
        for _,v in ipairs(changes) do if ip&gt;=v.address and ip&lt;v.address+#v.old then result=true end end
      end
      writeIntegerLocal(p,28);more=api('kernel32.Thread32Next',snap,p)
