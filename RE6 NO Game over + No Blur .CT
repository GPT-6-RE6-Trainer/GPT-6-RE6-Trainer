          and jump(s,code+27,0xe9)==address+6 and current[6]==0x90,'Unknown controller input hook')
      elseif v.kind=='blood' then
        assert(current[6]==0x90 and current[7]==0x90,'Unknown Game Over patch')
        checkKeepBlood(s,address,jump(s,address,0xe9))
      else assert(equal(current,bytes(v.patched)),'Foreign patch detected; memory was left unchanged') end
      changes[#changes+1]={address=address,old=current,new=original}
    end
  end
  -- Validate every site before restoring any of them.
  M.change(s,changes)
end
local function localStop(s)
  for _,name in ipairs(s.meta.timers or {}) do
    local t=_G[name];if t then t.Enabled=false;t.destroy();_G[name]=nil end
  end
  if s.key=='21848' then _G.fc_loop_running=false end
  for name,address in pairs(s.symbols or {}) do
    if getAddressSafe(name)==address then unregisterSymbol(name) end
  end
end
function M.stop(s)
  if not s or s.closed then return end
  local running=M.alive(s)
  if not running then s.critical=false;s.suspended=false end
  assert(not s.critical and not s.suspended,'Unresolved patch transaction; controller retained')
  if s.key=='1545' or s.key=='241' or s.key=='21848' then
    for _,key in ipairs({'21848','21913','21912','241'}) do
      if key~=s.key and (key~='241' or s.key=='1545') and M.states[key] then M.stop(M.states[key]) end
    end
  end
  -- An old CE may have left companion hooks that are not checked in this new table.
  if running and s.meta.release then M.recover(s,s.meta.release) end
  if s.enabled and running and #(s.meta.sites or {})&gt;0 then
    local changes={}
    for i,v in ipairs(s.meta.sites) do
      local address=s.base+v.rva;local original=bytes(v.original)
      local current=read(s,address,#original)
      if not equal(current,original) then
        assert(s.installed[i] and equal(current,s.installed[i].data),
          'The active patch was changed by another controller; refusing to overwrite it')
        changes[#changes+1]={address=address,old=current,new=original}
      end
    end
    -- Restore through the original handle even if CE is now viewing another process.
    M.change(s,changes)
    localStop(s)
    if s.key=='9002' then extra_respawn_patch_site=nil end
  elseif s.enabled and (M.current(s) or s.meta.ownedHandle) then
    local ok,err=autoAssemble(s.script,s.disableInfo)
    assert(ok,'Disable failed: '..tostring(err))
  else localStop(s) end
  if running then
    for _,v in ipairs(s.meta.restore or s.meta.sites or {}) do
      local original=bytes(v.original)
      assert(equal(read(s,s.base+v.rva,#original),original),
        string.format('Original bytes were NOT restored at BH6.exe+%X / 原始指令尚未恢复',v.rva))
    end
    for _,v in ipairs(s.meta.release or {}) do
      local original=bytes(v.original)
      assert(equal(read(s,s.base+v.rva,#original),original),'A companion camera patch was not restored')
    end
  end
  s.enabled=false
  if s.record then pcall(function()
    local function reset(record,children)
      if children then for i=record.Count-1,0,-1 do reset(record.Child[i],true) end end
      record.disableWithoutExecute()
    end
    reset(s.record,s.key=='1545' or s.key=='241')
  end) end
  if s.lock then
    if s.ownsLock then api('kernel32.ReleaseMutex',s.lock) end
    api('kernel32.CloseHandle',s.lock)
  end
  if s.handle then api('kernel32.CloseHandle',s.handle) end
  if s.buffer then s.buffer.destroy() end
  if s.scratch then s.scratch.destroy() end
  s.handle=nil;s.closed=true
  if M.states[s.key]==s then M.states[s.key]=nil end
end
function M.enable(key,record,script,meta)
  local old=M.states[key]
  if old then
    if M.current(old) and old.enabled then error('This feature is already active in this CE session / 此功能已在当前 CE 中启用') end
    M.stop(old)
  end
  local s={key=key,record=record,script=script,meta=meta or {}}
  M.serial=M.serial+1;s.serial=M.serial;M.states[key]=s
  local ok,err=xpcall(function()
    s.pid=getOpenedProcessID();s.base=getAddressSafe('BH6.exe')
    assert(s.pid and s.pid&gt;0 and s.base,'Attach BH6.exe first / 请先连接 BH6.exe')
    s.handle=must(api('kernel32.OpenProcess',0x100c38,0,s.pid),'OpenProcess')
    s.buffer=createMemoryStream();s.buffer.Size=0x2000
    s.scratch=createMemoryStream();s.scratch.Size=0x1000
    local header=read(s,s.base,0x1000);local pe=u32(header,0x3c)
    assert(pe&gt;=64 and pe+0x54&lt;#header and u32(header,pe)==0x4550 and u32(header,pe+8)==0x51960399
      and u32(header,pe+0x50)==0x14a1000,'Unsupported BH6.exe build')
    local p=s.scratch.Memory
    must(api('kernel32.GetProcessTimes',s.handle,p,p+8,p+16,p+24),'GetProcessTimes')
    local lockKey=(key=='21915' or key=='21919') and 'game_over' or key
    for _,other in pairs(M.states) do
      assert(other==s or other.lockKey~=lockKey or not M.alive(other),
        'An overlapping option is already active / 修改同一地址的另一个选项已启用')
    end
    s.lockKey=lockKey
    local name=string.format('Local\\RE6_CT_%s_%d_%08X%08X',lockKey,s.pid,readIntegerLocal(p+4),readIntegerLocal(p))
    s.lock=must(executeCodeLocalEx(getAddress('kernel32.CreateMutexW',true),
      {type=0,value=0},{type=0,value=0},{type=4,value=name}),'CreateMutexW')
    local acquired=api('kernel32.WaitForSingleObject',s.lock,0)
    assert(acquired==0 or acquired==0x80,'Another CE owns this feature / 另一份 CE 正在控制此功能')
    s.ownsLock=true
    M.recover(s,s.meta.sites)
    -- Only this entry's old names can survive a CE process retarget.
    for _,name in ipairs(s.meta.symbols or {}) do unregisterSymbol(name) end
    for _,name in ipairs(s.meta.staleSymbols or {}) do unregisterSymbol(name) end
    if key=='1545' or key=='21848' then _G.fc_loop_running=false end
    local assembled,info=autoAssemble(script)
    assert(assembled,tostring(info));s.disableInfo=info;s.enabled=true
    s.installed={}
    for _,v in ipairs(s.meta.sites or {}) do
      local address=s.base+v.rva
      s.installed[#s.installed+1]={address=address,data=read(s,address,#bytes(v.original))}
    end
    s.symbols={}
    for _,name in ipairs(s.meta.symbols or {}) do s.symbols[name]=getAddressSafe(name) end
  end,debug.traceback)
  if not ok then
    if not s.critical and not s.suspended then pcall(M.stop,s) end
    error(err)
  end
end
function M.disable(key,meta)
  local s=M.states[key]
  if s and meta then s.meta=meta end
  M.stop(s)
end
function M.stopAll()
  local list={};for _,s in pairs(M.states) do list[#list+1]=s end
  table.sort(list,function(a,b)return a.serial&gt;b.serial end)
  local errors={}
  for _,s in ipairs(list) do local ok,why=pcall(M.stop,s);if not ok then errors[#errors+1]=tostring(why) end end
  return #errors==0,table.concat(errors,'\n')
end
M.timer=createTimer(nil,false);M.timer.Interval=250
M.timer.OnTimer=function()
  local stale={}
  for _,s in pairs(M.states) do
    local ok,current=pcall(M.current,s)
    if (s.enabled or s.suspended or s.critical) and ok and not current then stale[#stale+1]=s end
  end
  table.sort(stale,function(a,b)return a.serial&gt;b.serial end)
  for _,s in ipairs(stale) do
    local ok,err=pcall(M.stop,s)
    if not ok and not s.reported then s.reported=true;print('[RE6 lifecycle] '..tostring(err)) end
  end
end
M.timer.Enabled=true
local form=getMainForm();local previous=form.OnCloseQuery
form.OnCloseQuery=function(sender)
  if previous and previous(sender)==false then return false end
  local ok,err=M.stopAll()
  if not ok then showMessage('Unable to restore one of this table\'s patches / 有补丁未能恢复：\n'..err);return false end
  return true
end
_G.RE6TableLifecycle20260915=M
return M
end)()
{$asm}
[ENABLE]
{$lua}
if syntaxcheck then return end
-- Encoded payload prevents CE's outer AA parser from interpreting nested section directives.
local source=(''):gsub('..',function(b)return string.char(tonumber(b,16))end)
_G.RE6TableLifecycle20260915.enable('63003',memrec or getAddressList().getMemoryRecordByID(63003),source,{["timers"]={"gpt6_texture_timer"},["symbols"]={}})
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
local lifecycle=_G.RE6TableLifecycle20260915
if lifecycle then lifecycle.disable('63003',{["timers"]={"gpt6_texture_timer"},["symbols"]={}}) end
{$asm}
</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols/>
</CheatTable>
