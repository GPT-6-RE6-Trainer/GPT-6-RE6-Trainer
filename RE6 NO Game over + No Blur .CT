        local h=must(api('kernel32.OpenThread',0x48,0,readIntegerLocal(p+8)),'OpenThread')
        local ctx=s.scratch.Memory+0x200;writeIntegerLocal(ctx,0x10001)
        local got=api('kernel32.Wow64GetThreadContext',h,ctx)
        local ip=readIntegerLocal(ctx+184);api('kernel32.CloseHandle',h)
        must(got,'Wow64GetThreadContext');count=count+1
