-- Shared by the three standalone tables; bootstrapped by each entry.
local previous=_G.RE6TableLifecycle20260915
if previous and previous.revision==5 then return previous end
local M=previous or {states={},serial=0}
if M.timer then M.timer.Enabled=false;M.timer.destroy() end
M.revision=5
local function api(name,...)
