local function localStop(s)
  for _,name in ipairs(s.meta.timers or {}) do
    local t=_G[name];if t then t.Enabled=false;t.destroy();_G[name]=nil end
  end
  if s.key=='21848' then _G.fc_loop_running=false end
  for name,address in pairs(s.symbols or {}) do
    if getAddressSafe(name)==address then unregisterSymbol(name) end
  end
end
function M.stop(s)
  if not s or s.closed then return end
  local running=M.alive(s)
  if not running then s.critical=false;s.suspended=false end
  assert(not s.critical and not s.suspended,'Unresolved patch transaction; controller retained')
  if s.key=='1545' or s.key=='241' or s.key=='21848' then
    for _,key in ipairs({'21848','21913','21912','241'}) do
      if key~=s.key and (key~='241' or s.key=='1545') and M.states[key] then M.stop(M.states[key]) end
    end
  end
  -- An old CE may have left companion hooks that are not checked in this new table.
  if running and s.meta.release then M.recover(s,s.meta.release) end
  if s.enabled and running and #(s.meta.sites or {})&gt;0 then
    local changes={}
    for i,v in ipairs(s.meta.sites) do
      local address=s.base+v.rva;local original=bytes(v.original)
      local current=read(s,address,#original)
      if not equal(current,original) then
        assert(s.installed[i] and equal(current,s.installed[i].data),
          'The active patch was changed by another controller; refusing to overwrite it')
        changes[#changes+1]={address=address,old=current,new=original}
      end
    end
    -- Restore through the original handle even if CE is now viewing another process.
    M.change(s,changes)
    localStop(s)
    if s.key=='9002' then extra_respawn_patch_site=nil end
  elseif s.enabled and (M.current(s) or s.meta.ownedHandle) then
    local ok,err=autoAssemble(s.script,s.disableInfo)
    assert(ok,'Disable failed: '..tostring(err))
  else localStop(s) end
  if running then
    for _,v in ipairs(s.meta.restore or s.meta.sites or {}) do
      local original=bytes(v.original)
      assert(equal(read(s,s.base+v.rva,#original),original),
        string.format('Original bytes were NOT restored at BH6.exe+%X / 原始指令尚未恢复',v.rva))
    end
    for _,v in ipairs(s.meta.release or {}) do
      local original=bytes(v.original)
      assert(equal(read(s,s.base+v.rva,#original),original),'A companion camera patch was not restored')
    end
  end
  s.enabled=false
  if s.record then pcall(function()
    local function reset(record,children)
      if children then for i=record.Count-1,0,-1 do reset(record.Child[i],true) end end
      record.disableWithoutExecute()
    end
    reset(s.record,s.key=='1545' or s.key=='241')
  end) end
  if s.lock then
    if s.ownsLock then api('kernel32.ReleaseMutex',s.lock) end
    api('kernel32.CloseHandle',s.lock)
  end
  if s.handle then api('kernel32.CloseHandle',s.handle) end
  if s.buffer then s.buffer.destroy() end
  if s.scratch then s.scratch.destroy() end
