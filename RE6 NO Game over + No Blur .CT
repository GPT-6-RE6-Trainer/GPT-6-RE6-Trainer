local function checkKeepBlood(s,site,code)
  local function expect(p,hex)
    local b=bytes(hex);assert(equal(read(s,p,#b),b),'Unknown Game Over hook');return p+#b
  end
  local function branch(p,short,near)
    local b=read(s,p,6)
    if b[1]==short then return p+2+((b[2]&gt;=128) and b[2]-256 or b[2]),p+2 end
    assert(b[1]==0x0f and b[2]==near,'Unknown Game Over condition')
    return (p+6+u32(b,2))&amp;0xffffffff,p+6
  end
  local function jmp(p)
    local b=read(s,p,5)
    if b[1]==0xeb then return p+2+((b[2]&gt;=128) and b[2]-256 or b[2]) end
