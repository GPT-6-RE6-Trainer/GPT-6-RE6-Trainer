-- Only entry-point writes require a short, verified transaction. Caves are retained.
function M.change(s,changes)
  if #changes==0 then return end
  assert(M.alive(s),'The original game process exited')
  for attempt=1,30 do
    local status=api('ntdll.NtSuspendProcess',s.handle)
    assert(status and (status&amp;0x80000000)==0,'NtSuspendProcess failed')
    s.suspended=true
    local retry=false;local attempted={};local protections={}
    local ok,err=xpcall(function()
      retry=busy(s,changes);if retry then return end
      for _,v in ipairs(changes) do assert(equal(read(s,v.address,#v.old),v.old),'Patch changed during recovery') end
      for _,v in ipairs(changes) do
        protections[#protections+1]={v.address,#v.old,protect(s,v.address,#v.old,0x40)}
        attempted[#attempted+1]=v;write(s,v.address,v.new)
      end
    end,debug.traceback)
    if not ok then
      for i=#attempted,1,-1 do
        local v=attempted[i]
        if not pcall(write,s,v.address,v.old) then s.critical=true end
      end
    end
    for i=#protections,1,-1 do
      local p=protections[i];local restored,why=pcall(protect,s,p[1],p[2],p[3])
      if not restored then ok=false;err=tostring(err)..'\n'..tostring(why) end
    end
    if s.critical then error('Patch rollback failed; controller retained for recovery') end
    local resumed=api('ntdll.NtResumeProcess',s.handle)
    assert(resumed and (resumed&amp;0x80000000)==0,'NtResumeProcess failed; controller retained')
    s.suspended=false
    assert(ok,err)
    if not retry then return end
    sleep(5)
  end
  error('Game thread is inside the patch; retry enabling this entry')
end
local function jump(s,address,opcode)
  local t=read(s,address,5);assert(t[1]==opcode,'Unknown hook opcode')
  return (address+5+u32(t,1))&amp;0xffffffff
end
local function checkKeepBlood(s,site,code)
  local function expect(p,hex)
    local b=bytes(hex);assert(equal(read(s,p,#b),b),'Unknown Game Over hook');return p+#b
  end
  local function branch(p,short,near)
    local b=read(s,p,6)
    if b[1]==short then return p+2+((b[2]&gt;=128) and b[2]-256 or b[2]),p+2 end
    assert(b[1]==0x0f and b[2]==near,'Unknown Game Over condition')
    return (p+6+u32(b,2))&amp;0xffffffff,p+6
  end
  local function jmp(p)
    local b=read(s,p,5)
    if b[1]==0xeb then return p+2+((b[2]&gt;=128) and b[2]-256 or b[2]) end
    return jump(s,p,0xe9)
  end
  local p=expect(code,'83 F9 01');local skip
  skip,p=branch(p,0x75,0x85)
  assert(equal(read(s,p,6),join(bytes('81 3E'),packed(s.base+0x1190f40))),'Unknown Game Over type gate');p=p+6
  local skip2;skip2,p=branch(p,0x74,0x84);assert(skip2==skip,'Unknown Game Over target')
  p=expect(p,'8B 16 83 E0 FA')
  local ret=jmp(p)
  assert(jmp(skip)==site+0x59 and jmp(ret)==site+7,'Unknown Game Over return')
end
function M.recover(s,spec)
  local changes={}
  for _,v in ipairs(spec or {}) do
    local address=s.base+v.rva;local original=bytes(v.original)
    local current=read(s,address,#original)
    if v.context then assert(equal(read(s,address+#original,#bytes(v.context)),bytes(v.context)),'Unsupported patch context') end
    if not equal(current,original) then
      if v.kind=='camera' then
        local code=jump(s,address,0xe9)
        assert(equal(read(s,code,14),join(bytes('89 0D'),packed(code-4),original))
          and jump(s,code+14,0xe9)==address+8,'Unknown camera hook; no takeover attempted')
        local padding={current[6],current[7],current[8]}
        assert(equal(padding,{0x90,0x90,0x90}) or equal(padding,{0x0f,0x1f,0x00}),'Unknown camera padding')
      elseif v.kind=='input' then
        local code=jump(s,address,0xe9)
        assert(equal(read(s,code-6,6),original) and equal(read(s,code,27),
          join(bytes('83 A6 AC 02 00 00 00 83 A6 B0 02 00 00 00 83 A6 B4 02 00 00 00'),original))
          and jump(s,code+27,0xe9)==address+6 and current[6]==0x90,'Unknown controller input hook')
      elseif v.kind=='blood' then
        assert(current[6]==0x90 and current[7]==0x90,'Unknown Game Over patch')
        checkKeepBlood(s,address,jump(s,address,0xe9))
      else assert(equal(current,bytes(v.patched)),'Foreign patch detected; memory was left unchanged') end
      changes[#changes+1]={address=address,old=current,new=original}
    end
