local function busy(s,changes)
  local snap=api('kernel32.CreateToolhelp32Snapshot',4,0)
  assert(snap and snap~=0 and snap~=-1,'Thread snapshot failed')
  local result=false
  local ok,err=pcall(function()
    local p=s.scratch.Memory+0x100;writeIntegerLocal(p,28)
    local more=must(api('kernel32.Thread32First',snap,p),'Thread32First')
    local count=0
    while more~=0 do
      if readIntegerLocal(p+12)==s.pid then
        local h=must(api('kernel32.OpenThread',0x48,0,readIntegerLocal(p+8)),'OpenThread')
        local ctx=s.scratch.Memory+0x200;writeIntegerLocal(ctx,0x10001)
        local got=api('kernel32.Wow64GetThreadContext',h,ctx)
        local ip=readIntegerLocal(ctx+184);api('kernel32.CloseHandle',h)
        must(got,'Wow64GetThreadContext');count=count+1
        for _,v in ipairs(changes) do if ip&gt;=v.address and ip&lt;v.address+#v.old then result=true end end
      end
      writeIntegerLocal(p,28);more=api('kernel32.Thread32Next',snap,p)
    end
    assert(count&gt;0,'No game threads found')
  end)
  api('kernel32.CloseHandle',snap);assert(ok,err);return result
end
-- Only entry-point writes require a short, verified transaction. Caves are retained.
function M.change(s,changes)
  if #changes==0 then return end
  assert(M.alive(s),'The original game process exited')
  for attempt=1,30 do
    local status=api('ntdll.NtSuspendProcess',s.handle)
    assert(status and (status&amp;0x80000000)==0,'NtSuspendProcess failed')
    s.suspended=true
    local retry=false;local attempted={};local protections={}
    local ok,err=xpcall(function()
      retry=busy(s,changes);if retry then return end
      for _,v in ipairs(changes) do assert(equal(read(s,v.address,#v.old),v.old),'Patch changed during recovery') end
      for _,v in ipairs(changes) do
        protections[#protections+1]={v.address,#v.old,protect(s,v.address,#v.old,0x40)}
        attempted[#attempted+1]=v;write(s,v.address,v.new)
      end
    end,debug.traceback)
    if not ok then
      for i=#attempted,1,-1 do
        local v=attempted[i]
        if not pcall(write,s,v.address,v.old) then s.critical=true end
      end
    end
    for i=#protections,1,-1 do
      local p=protections[i];local restored,why=pcall(protect,s,p[1],p[2],p[3])
      if not restored then ok=false;err=tostring(err)..'\n'..tostring(why) end
